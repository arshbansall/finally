# Copy to .env and fill in:  cp .env.example .env

# Required for AI chat: OpenRouter API key (not needed when LLM_MOCK=true)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Needs a plan with the stocks snapshot endpoint (Starter or above; Starter is
# 15-minute delayed). A free (Stocks Basic) or invalid key, or an unreachable API,
# falls back to the built-in simulator automatically (a warning is logged).
# Leave empty to use the simulator (recommended).
MASSIVE_API_KEY=

# Optional: seconds between Massive polls
MASSIVE_POLL_INTERVAL=15

# Optional: "true" for deterministic mock LLM responses (testing / no API key)
LLM_MOCK=false

# Advanced (defaults are fine; the Docker image sets these itself):
# FINALLY_DB_PATH=db/finally.db
# FINALLY_STATIC_DIR=backend/static
